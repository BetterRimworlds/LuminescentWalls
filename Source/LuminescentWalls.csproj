    <DefineConstants>RIMWORLD17</DefineConstants>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>/rimworld/1.2/Mods/LuminescentWalls/1.7/Assemblies</OutputPath>
  </PropertyGroup>

