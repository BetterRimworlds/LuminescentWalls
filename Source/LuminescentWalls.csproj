<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>BetterRimworlds.LuminescentWalls</RootNamespace>
    <AssemblyName>LuminescentWalls</AssemblyName>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Release v1.2;Release v1.3;Release v1.4;Release v1.5;Release v1.6;Release v1.7</Configurations>
  </PropertyGroup>

  <!-- Configuration-specific properties -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release v1.2'">
    <Optimize>true</Optimize>
    <DefineConstants>RIMWORLD12</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <OutputPath>/rimworld/1.2/Mods/LuminescentWalls/1.2/Assemblies</OutputPath>
    <MainPath>/tmp/rimworld/1.2/Mods/LuminescentWalls/1.2/Assemblies</MainPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release v1.3'">
    <DefineConstants>RIMWORLD13</DefineConstants>
    <OutputPath>/rimworld/1.2/Mods/LuminescentWalls/1.3/Assemblies</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release v1.4'">
    <DefineConstants>RIMWORLD14</DefineConstants>
